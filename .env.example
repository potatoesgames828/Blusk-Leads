# ─── Banco de dados (PostgreSQL 15+; Supabase, Neon ou local) ───
# Usuário dono das tabelas. O app troca para o papel restrito "blusk_app"
# em cada transação de usuário, então a RLS vale de verdade.
DATABASE_URL=postgres://blusk_owner:blusk@localhost:5432/blusk_dev

# URL pública do app (links de e-mail, verificação de origem)
APP_URL=http://localhost:3000

# ─── Provedor de leads ───
# "google_places" em produção. "fake" gera dados FICTÍCIOS (só desenvolvimento/testes).
LEAD_PROVIDER=fake
GOOGLE_PLACES_API_KEY=
# Teto diário de chamadas ao provedor (todas as contas somadas)
PROVIDER_DAILY_CALL_LIMIT=500

# ─── IA (opcional: sem chave, usa gerador de modelos determinístico e honesto) ───
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ─── E-mail transacional (opcional: sem chave, e-mails ficam na caixa de dev /dev/emails) ───
RESEND_API_KEY=
EMAIL_FROM="Blusk Leads <nao-responda@blusk.com.br>"

# Segredo para o endpoint de manutenção agendada (/api/cron/maintenance)
CRON_SECRET=troque-este-valor

# E-mails que viram administradores ao se cadastrar (separados por vírgula)
ADMIN_EMAILS=
